#!/usr/bin/python3
"""Root-owned bridge: only fixed Pulse capture/playback/check commands as voice."""
import os
import pwd
import re
import signal
import subprocess
import sys

if os.getuid() != pwd.getpwnam('voice').pw_uid:
    raise SystemExit('Run this helper as voice')
uid = os.getuid()
environment = {'PATH': '/usr/bin:/bin', 'HOME': pwd.getpwuid(uid).pw_dir,
               'XDG_RUNTIME_DIR': f'/run/user/{uid}',
               'PULSE_SERVER': f'unix:/run/user/{uid}/pulse/native'}
args = sys.argv[1:]
if args == ['check']:
    for kind, required in [('sources', 'voice_aec_source'), ('sinks', 'voice_aec_sink')]:
        result = subprocess.run(['/usr/bin/pactl', 'list', kind, 'short'], env=environment,
                                capture_output=True, text=True, check=True)
        if not any(len(row.split()) > 1 and row.split()[1] == required
                   for row in result.stdout.splitlines()):
            raise SystemExit(f'Missing AEC node: {required}')
    print('AEC source/sink present under voice')
    raise SystemExit(0)
if len(args) != 2 or args[0] not in ('capture', 'playback') or not re.fullmatch(r'[A-Za-z0-9_.-]+', args[1]):
    raise SystemExit('Expected: check | capture SOURCE | playback SINK')
if args[0] == 'capture':
    command = ['/usr/bin/parec', '--raw', '--device=' + args[1], '--format=s16le', '--rate=16000', '--channels=2']
else:
    command = ['/usr/bin/pacat', '--playback', '--raw', '--device=' + args[1], '--format=s16le',
               '--rate=48000', '--channels=2', '--latency-msec=40']
child = None

def stop(signum, frame):
    if child and child.poll() is None:
        child.kill()
    raise SystemExit(128 + signum)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
try:
    child = subprocess.Popen(command, env=environment)
    raise SystemExit(child.wait())
finally:
    if child and child.poll() is None:
        child.kill()
        child.wait()
