#!/usr/bin/python3
"""Root-owned bridge: only fixed Pulse capture/playback/check commands as voice."""
import os
import json
import pwd
import re
import signal
import subprocess
import sys

if os.getuid() != pwd.getpwnam('voice').pw_uid:
    raise SystemExit('Run this helper as voice')
uid = os.getuid()
environment = {'PATH': '/usr/bin:/bin', 'HOME': pwd.getpwuid(uid).pw_dir,
               'XDG_RUNTIME_DIR': f'/run/user/{uid}',
               'PULSE_SERVER': f'unix:/run/user/{uid}/pulse/native'}
args = sys.argv[1:]
if args == ['prepare']:
    from music_duck import prepare_output, restore_hardware_output
    subprocess.run(['/usr/bin/pw-metadata', '-n', 'settings', '0', 'clock.force-quantum', '480'],
                   env=environment, check=True, timeout=5, stdout=subprocess.DEVNULL)
    restore_hardware_output(environment)
    prepare_output(environment)
    raise SystemExit(0)
if args == ['duck']:
    from music_duck import serve
    serve(environment)
    raise SystemExit(0)
if args == ['check']:
    for kind, required in [('sources', 'voice_aec_source'), ('sinks', 'voice_aec_sink')]:
        result = subprocess.run(['/usr/bin/pactl', 'list', kind, 'short'], env=environment,
                                capture_output=True, text=True, check=True)
        if not any(len(row.split()) > 1 and row.split()[1] == required
                   for row in result.stdout.splitlines()):
            raise SystemExit(f'Missing AEC node: {required}')
    print('AEC source/sink present under voice')
    raise SystemExit(0)
if len(args) == 2 and args[0] == 'volume':
    value = args[1]
    if value not in ('up', 'down') and not (value.isascii() and value.isdecimal() and 0 <= int(value) <= 100):
        raise SystemExit('Expected volume up | down | 0..100')
    result = subprocess.run(['/usr/bin/pactl', '--format=json', 'list', 'sinks'],
                            env=environment, capture_output=True, text=True, check=True, timeout=3)
    sink = next((s for s in json.loads(result.stdout) if s['name'] == 'voice_aec_sink'), None)
    if sink is None:
        raise SystemExit('Missing voice_aec_sink')
    # Pulse normal volume = 65536. Keep left/right balanced and never amplify above 100%.
    current = round(sum(v['value'] for v in sink['volume'].values()) /
                    len(sink['volume']) * 100 / 65536)
    amount = max(0, min(100, current + (10 if value == 'up' else -10))) if value in ('up', 'down') else int(value)
    subprocess.run(['/usr/bin/pactl', 'set-sink-volume', 'voice_aec_sink', f'{amount}%'],
                   env=environment, check=True, timeout=3)
    subprocess.run(['/usr/bin/pactl', 'set-sink-mute', 'voice_aec_sink', '0'],
                   env=environment, check=True, timeout=3)
    print(f'Общая громкость: {amount}%.')
    raise SystemExit(0)
if len(args) != 2 or args[0] not in ('capture', 'playback') or not re.fullmatch(r'[A-Za-z0-9_.-]+', args[1]):
    raise SystemExit('Expected: check | capture SOURCE | playback SINK')
if args[0] == 'capture':
    command = ['/usr/bin/parec', '--raw', '--device=' + args[1], '--format=s16le', '--rate=16000', '--channels=2']
else:
    command = ['/usr/bin/pacat', '--playback', '--raw', '--device=' + args[1], '--format=s16le',
               '--rate=48000', '--channels=2', '--latency-msec=120']
child = None

def stop(signum, frame):
    if child and child.poll() is None:
        child.kill()
    raise SystemExit(128 + signum)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
try:
    child = subprocess.Popen(command, env=environment)
    raise SystemExit(child.wait())
finally:
    if child and child.poll() is None:
        child.kill()
        child.wait()
