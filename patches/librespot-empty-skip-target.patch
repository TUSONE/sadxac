+
+#[cfg(test)]
+mod skip_to_tests {
+    use super::*;
+
+    #[test]
+    fn empty_uri_does_not_hide_uid() {
+        let skip = SkipTo {
+            track_uri: Some(String::new()),
+            track_uid: Some("selected-uid".into()),
+            track_index: None,
+        };
+        assert!(
+            matches!(PlayingTrack::try_from(skip), Ok(PlayingTrack::Uid(uid)) if uid == "selected-uid")
+        );
+    }
+
+    #[test]
+    fn empty_identifiers_do_not_hide_index() {
+        let skip = SkipTo {
+            track_uri: Some(" ".into()),
+            track_uid: Some(String::new()),
+            track_index: Some(2),
+        };
+        assert!(matches!(
+            PlayingTrack::try_from(skip),
+            Ok(PlayingTrack::Index(2))
+        ));
+    }
+
+    #[test]
+    fn real_uri_keeps_precedence() {
+        let skip = SkipTo {
+            track_uri: Some("spotify:track:selected".into()),
+            track_uid: Some("uid".into()),
+            track_index: Some(2),
+        };
+        assert!(
+            matches!(PlayingTrack::try_from(skip), Ok(PlayingTrack::Uri(uri)) if uri == "spotify:track:selected")
+        );
+    }
+
+    #[test]
+    fn missing_target_is_rejected() {
+        let skip = SkipTo {
+            track_uri: Some(String::new()),
+            track_uid: Some(String::new()),
+            track_index: None,
+        };
+        assert!(PlayingTrack::try_from(skip).is_err());
+    }
+}
